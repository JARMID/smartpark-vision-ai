      selectedPaymentCard = type;
      if (type === 'EDAHABIA') {
        document.getElementById('card-btn-edahabia').className = 'p-2.5 rounded-xl border border-teal-500/60 bg-teal-950/40 text-left flex items-center space-x-2.5';
        document.getElementById('card-btn-cib').className = 'p-2.5 rounded-xl border border-gray-800 bg-black/40 text-left flex items-center space-x-2.5';
        document.getElementById('card-number').value = '6280 1400 9821 4410';
      } else {
        document.getElementById('card-btn-cib').className = 'p-2.5 rounded-xl border border-teal-500/60 bg-teal-950/40 text-left flex items-center space-x-2.5';
        document.getElementById('card-btn-edahabia').className = 'p-2.5 rounded-xl border border-gray-800 bg-black/40 text-left flex items-center space-x-2.5';
        document.getElementById('card-number').value = '5324 0000 1234 5678';
      }
    }

    async function submitChargilyPayment() {
      const btn = document.getElementById('pay-submit-btn');
      btn.innerHTML = '<i data-lucide="loader" class="w-3.5 h-3.5 animate-spin"></i> Traitement...';
      btn.disabled = true;

      setTimeout(async () => {
        document.getElementById('chargily-success-box').classList.remove('hidden');
        btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i> Validé';
        btn.className = 'px-4 py-1.5 bg-emerald-600 text-white rounded-lg font-bold';
        playChime(true);
        cam3.openBarrier();

        if (isConnectedToBackend) {
          try {
            await fetch('/api/chargily/pay', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ checkout_id: 'ch_inv_demo', otp_code: '481902' })
            });
          } catch (e) {}
        }
      }, 1200);
    }

    function openGuardDrawer() { document.getElementById('guard-drawer').classList.remove('hidden'); }
    function closeGuardDrawer() { document.getElementById('guard-drawer').classList.add('hidden'); }

    async function submitGuardDecision(decision) {
      closeGuardDrawer();
      if (decision === 'grant') {
        playChime(true);
        manualBarrierOverride(1);
      } else {
        playChime(false);
      }

      if (isConnectedToBackend) {
        try {
          await fetch('/api/guard/decision', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plate: '04122 118 16', decision: decision, reason: 'Arbitrage agent de garde' })
          });
        } catch (e) {}
      }
    }

    function inspectCamera(num) {
      document.getElementById('cam-modal-title').innerText = `Inspection Caméra HD : CAM-0${num}`;
      document.getElementById('cam-modal').classList.remove('hidden');
      const cvs = document.getElementById('cam-inspector-canvas');
      const ctx = cvs.getContext('2d');
      cvs.width = 640; cvs.height = 360;
      ctx.fillStyle = '#060A14';
      ctx.fillRect(0, 0, cvs.width, cvs.height);
      ctx.fillStyle = '#10B981';
      ctx.font = '14px JetBrains Mono';
      ctx.fillText(`FLUX DIRECT HD CAM-0${num} | 1080P NVDEC`, 20, 40);
    }
    function closeCameraModal() { document.getElementById('cam-modal').classList.add('hidden'); }

    // =======================================================
    // WEBSOCKET CLIENT
    // =======================================================
    if (window.location.protocol.startsWith('http')) {
      try {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${protocol}//${window.location.host}/ws`);

        ws.onopen = () => {
          isConnectedToBackend = true;
          document.getElementById('backend-dot').className = 'w-2 h-2 rounded-full bg-emeraldAccent pulsing-indicator';
          document.getElementById('backend-text').innerText = 'Serveur: FastAPI + FAISS';
        };

        ws.onmessage = (e) => {
          try {
            const msg = JSON.parse(e.data);
            if (msg.type === 'GATE_EVENT' || msg.type === 'SECURITY_ALERT' || msg.type === 'SPOOF_ALERT' || msg.type === 'GUARD_PROMPT' || msg.type === 'EXIT_CLEARED') {
              addEventCard(msg.data);
            } else if (msg.type === 'SLOTS_UPDATED') {
              renderStalls(msg.slots);
            }
          } catch (err) {}
        };

        ws.onerror = () => { isConnectedToBackend = false; };
        ws.onclose = () => { isConnectedToBackend = false; };
      } catch (e) {
        isConnectedToBackend = false;
      }
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        e.preventDefault();
        manualBarrierOverride(1);
      } else if (e.key === '1') {
        triggerScenario('vip_entry');
      } else if (e.key === '2') {
        triggerScenario('temporary_00');
      } else if (e.key === '3') {
        triggerScenario('watchlist_alert');
      } else if (e.key === '4') {
        triggerScenario('spoof_attack');
      } else if (e.key === '5') {
        triggerScenario('driver_mismatch');
      } else if (e.key === '6') {
        triggerScenario('visitor_payment_exit');
      } else if (e.key === 'Escape') {
        closeGuideModal();
        closeAnpdpModal();
        closeTicketModal();
        closeChargilyModal();
        closeGuardDrawer();
        closeCameraModal();
      }
    });

    // Initialize Theme & Language on boot
    applyTheme(currentTheme);
    switchLanguage(currentLang);
    lucide.createIcons();
  </script>
</body>
</html>
