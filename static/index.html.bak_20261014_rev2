    function setupCam1() {
      const cvs = document.getElementById('cam1-canvas');
      const ctx = cvs.getContext('2d');
      cvs.width = 480; cvs.height = 270;
      let carY = 320, active = false, plateText = "104822 119 16", scanY = 0;
      let frameCount = 0;

      function render() {
        frameCount++;
        const isLight = document.documentElement.classList.contains('light');

        // Sky & Background Horizon
        if (isLight) {
          const skyGrad = ctx.createLinearGradient(0, 0, 0, 80);
