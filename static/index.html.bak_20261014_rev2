        // 1. Perspective Roadway Pavement
        const roadGrad = ctx.createLinearGradient(0, 40, 0, cvs.height);
        if (isLight) {
          roadGrad.addColorStop(0, '#64748B');
          roadGrad.addColorStop(0.3, '#475569');
          roadGrad.addColorStop(1, '#334155');
        } else {
          roadGrad.addColorStop(0, '#0F172A');
          roadGrad.addColorStop(0.4, '#0A101D');
          roadGrad.addColorStop(1, '#020617');
        }
        ctx.fillStyle = roadGrad;
        ctx.beginPath();
        ctx.moveTo(170, 45); ctx.lineTo(310, 45);
        ctx.lineTo(450, cvs.height - 20); ctx.lineTo(30, cvs.height - 20);
        ctx.closePath(); ctx.fill();

        // White Roadway Shoulder Lines
        ctx.strokeStyle = isLight ? '#FFFFFF' : 'rgba(241, 245, 249, 0.6)';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(175, 45); ctx.lineTo(38, cvs.height - 20);
        ctx.moveTo(305, 45); ctx.lineTo(442, cvs.height - 20);
        ctx.stroke();

        // Double Solid Yellow Safety Centerline
