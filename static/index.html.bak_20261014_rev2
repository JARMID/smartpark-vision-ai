        ctx.beginPath();
        ctx.ellipse(winX + winW / 2, winY + 46, 16, 12, 0, 0, Math.PI);
        ctx.fill();

        // Night Overhead Floodlight Spot
        if (!isLight) {
          const floodGrad = ctx.createRadialGradient(boothX + 30, boothY, 5, 180, 150, 160);
          floodGrad.addColorStop(0, 'rgba(254, 240, 138, 0.22)');
          floodGrad.addColorStop(1, 'rgba(254, 240, 138, 0)');
          ctx.fillStyle = floodGrad;
          ctx.beginPath();
          ctx.moveTo(boothX + 30, boothY); ctx.lineTo(80, 240); ctx.lineTo(340, 240);
          ctx.closePath(); ctx.fill();
        }

        // 4. Ground Inductive Presence Loop
        ctx.strokeStyle = active ? '#10B981' : '#EAB308';
        ctx.lineWidth = 2;
        ctx.strokeRect(155, 160, 170, 52);
        ctx.fillStyle = active ? 'rgba(16, 185, 129, 0.14)' : 'rgba(234, 179, 8, 0.08)';
        ctx.fillRect(155, 160, 170, 52);

        // Loop Corner Cuts
        ctx.strokeStyle = active ? '#10B981' : '#CA8A04';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(155, 168); ctx.lineTo(163, 160);
        ctx.moveTo(317, 160); ctx.lineTo(325, 168);
        ctx.moveTo(155, 204); ctx.lineTo(163, 212);
        ctx.moveTo(317, 212); ctx.lineTo(325, 204);
