        ctx.lineWidth = 2;
        ctx.strokeRect(135, 126, 88, 96);
        ctx.fillStyle = isLoopAOccupied ? 'rgba(6, 182, 212, 0.22)' : (isLight ? 'rgba(255, 255, 255, 0.15)' : 'rgba(30, 41, 59, 0.25)');
        ctx.fillRect(135, 126, 88, 96);

        // Loop Chamfered Corner Cuts
        ctx.strokeStyle = isLoopAOccupied ? '#06B6D4' : (isLight ? '#94A3B8' : '#334155');
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(135, 136); ctx.lineTo(145, 126);
        ctx.moveTo(213, 126); ctx.lineTo(223, 136);
        ctx.moveTo(135, 212); ctx.lineTo(145, 222);
        ctx.moveTo(213, 222); ctx.lineTo(223, 212);
        ctx.stroke();

        ctx.fillStyle = isLoopAOccupied ? '#06B6D4' : (isLight ? '#1E293B' : '#64748B');
        ctx.font = 'bold 8px JetBrains Mono';
        const loopALabel = currentLang === 'ar' ? (isLoopAOccupied ? 'المستشعر أ: رصد المركبة' : 'المستشعر أ (انتظار)') : (currentLang === 'en' ? (isLoopAOccupied ? 'LOOP A: ACTIVE' : 'LOOP A (STANDBY)') : (isLoopAOccupied ? 'BOUCLE A : ACTIF (-3.4%)' : 'BOUCLE A (ATTENTE)'));
        ctx.fillText(loopALabel, 140, 138);

        const isLoopBOccupied = carRolling && carX >= 270 && carX <= 430;
        ctx.strokeStyle = isLoopBOccupied ? '#10B981' : (isLight ? '#64748B' : '#475569');
        ctx.lineWidth = 2;
        ctx.strokeRect(285, 126, 88, 96);
        ctx.fillStyle = isLoopBOccupied ? 'rgba(16, 185, 129, 0.22)' : (isLight ? 'rgba(255, 255, 255, 0.15)' : 'rgba(30, 41, 59, 0.25)');
        ctx.fillRect(285, 126, 88, 96);
        ctx.fillStyle = isLoopBOccupied ? '#10B981' : (isLight ? '#1E293B' : '#64748B');
        ctx.font = 'bold 8px JetBrains Mono';
        const loopBLabel = currentLang === 'ar' ? (isLoopBOccupied ? 'المستشعر ب: إخلاء المسلك' : 'المستشعر ب (مغادرة)') : (currentLang === 'en' ? (isLoopBOccupied ? 'LOOP B: CLEARED' : 'LOOP B (DEPARTURE)') : (isLoopBOccupied ? 'BOUCLE B : PASSAGE OK' : 'BOUCLE B (DEGAGEMENT)'));
        ctx.fillText(loopBLabel, 290, 138);

        // 3. Optical Safety Photocell Beam
        const isBeamBroken = carRolling && carX >= 185 && carX <= 325;
        ctx.fillStyle = '#F59E0B';
        ctx.fillRect(250, 95, 7, 14);
        ctx.fillRect(250, 243, 7, 14);
        ctx.fillStyle = '#020617';
        ctx.fillRect(251, 100, 5, 5);
        ctx.fillRect(251, 246, 5, 5);

        // Infrared Safety Beam
        ctx.strokeStyle = isBeamBroken ? '#EF4444' : 'rgba(6, 182, 212, 0.55)';
