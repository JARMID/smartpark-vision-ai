        ctx.setLineDash(isBeamBroken ? [4, 4] : [2, 6]);
        ctx.beginPath();
        ctx.moveTo(253, 105); ctx.lineTo(253, 246);
        ctx.stroke();
        ctx.setLineDash([]);
        if (isBeamBroken) {
