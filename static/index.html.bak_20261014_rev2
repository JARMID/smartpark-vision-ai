          ctx.fillText(beamAlert, 160, 242);
        }

        // 4. Heavy Galvanized Structural Toll Gantry
        [15, 450].forEach(colX => {
          const colGrad = ctx.createLinearGradient(colX, 0, colX + 16, 0);
          if (isLight) {
            colGrad.addColorStop(0, '#64748B');
            colGrad.addColorStop(0.5, '#94A3B8');
            colGrad.addColorStop(1, '#475569');
          } else {
            colGrad.addColorStop(0, '#334155');
            colGrad.addColorStop(0.5, '#64748B');
            colGrad.addColorStop(1, '#1E293B');
