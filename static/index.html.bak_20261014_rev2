        { body: '#0F172A', roof: '#020617', glass: '#0369A1' },
        { body: '#F1F5F9', roof: '#E2E8F0', glass: '#0284C7' },
        { body: '#1E3A8A', roof: '#172554', glass: '#38BDF8' },
        { body: '#831843', roof: '#500724', glass: '#0284C7' },
        { body: '#334155', roof: '#1E293B', glass: '#0284C7' },
        { body: '#047857', roof: '#064E3B', glass: '#38BDF8' },
      ];

      function render() {
        frameCount++;
        const isLight = document.documentElement.classList.contains('light');

        // 1. Industrial Epoxy Parking Deck Floor
        const floorGrad = ctx.createLinearGradient(0, 0, cvs.width, cvs.height);
