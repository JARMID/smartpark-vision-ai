          ctx.fillRect(winX, winY, winW, winH);
          ctx.strokeStyle = '#3B82F6';
          ctx.strokeRect(winX, winY, winW, winH);
        } else {
          const winGrad = ctx.createLinearGradient(winX, winY, winX + winW, winY + winH);
          winGrad.addColorStop(0, 'rgba(251, 191, 36, 0.55)');
          winGrad.addColorStop(1, 'rgba(217, 119, 6, 0.25)');
          ctx.fillStyle = winGrad;
          ctx.fillRect(winX, winY, winW, winH);
          ctx.strokeStyle = '#D97706';
          ctx.strokeRect(winX, winY, winW, winH);
        }

        // Security Guard Silhouette Inside Window
        ctx.fillStyle = isLight ? 'rgba(30, 41, 59, 0.85)' : 'rgba(15, 23, 42, 0.9)';
        ctx.beginPath();
        ctx.arc(winX + winW / 2, winY + 20, 10, 0, Math.PI * 2);
