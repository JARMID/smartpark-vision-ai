          ctx.beginPath();
          ctx.moveTo(x1, y1); ctx.lineTo(x2, y2);
          ctx.lineTo(x2 - 14, y2 + 4); ctx.lineTo(x1 - 14, y1 + 4);
          ctx.closePath(); ctx.fill();
          ctx.strokeStyle = isLight ? '#64748B' : '#1E293B'; ctx.lineWidth = 0.8; ctx.stroke();
