            ctx.lineTo(carX + 210, vy + 48);
            ctx.lineTo(carX + 118, vy + 32);
            ctx.closePath();
            ctx.fill();
          }

          // Rear Taillights
          ctx.fillStyle = '#EF4444';
          ctx.fillRect(carX, vy + 18, 3, 8);
          if (!isLight) {
            const rGlow = ctx.createRadialGradient(carX, vy + 22, 1, carX, vy + 22, 14);
            rGlow.addColorStop(0, 'rgba(239, 68, 68, 0.5)');
            rGlow.addColorStop(1, 'rgba(239, 68, 68, 0)');
            ctx.fillStyle = rGlow;
            ctx.beginPath(); ctx.arc(carX, vy + 22, 14, 0, Math.PI * 2); ctx.fill();
          }

          // Authentic Algerian Rear License Plate
          ctx.fillStyle = '#FDE047';
          ctx.fillRect(carX + 2, vy + 29, 28, 9);
          ctx.strokeStyle = '#000000'; ctx.lineWidth = 0.8; ctx.strokeRect(carX + 2, vy + 29, 28, 9);
          ctx.fillStyle = '#000000';
          ctx.font = 'bold 5.5px JetBrains Mono';
          ctx.fillText('08192 120 09', carX + 4, vy + 36);

          // ALPR Tracking Box
          if (carX < 240) {
            ctx.strokeStyle = '#10B981'; ctx.lineWidth = 1.2;
            ctx.strokeRect(carX - 2, vy + 24, 38, 18);
            ctx.fillStyle = 'rgba(6, 11, 25, 0.92)';
            ctx.fillRect(carX - 10, vy + 2, 98, 15);
            ctx.strokeStyle = '#10B981'; ctx.lineWidth = 1;
            ctx.strokeRect(carX - 10, vy + 2, 98, 15);
            ctx.fillStyle = '#10B981';
            ctx.font = 'bold 7px JetBrains Mono';
            ctx.fillText('● SATIM CIB VALIDE [09 BLIDA]', carX - 6, vy + 12);
          }

          if (carX > cvs.width + 70) {
            carRolling = false;
            targetAngle = 0;
            const armEl = document.getElementById('cam3-arm-text');
            if (armEl) {
              armEl.innerText = currentLang === 'ar' ? 'مغلق' : (currentLang === 'en' ? 'CLOSED' : 'BAISSEE');
              armEl.className = 'text-red-400 font-semibold';
            }
          }
        }

        // 6. Automatic Industrial Barrier Pillar & Articulated Boom Arm
        const pillarX = 265, pillarY = 82, pillarW = 28, pillarH = 150;

        // RAL 2004 Orange Powder-Coated Steel Cabinet
        const cabGrad = ctx.createLinearGradient(pillarX, 0, pillarX + pillarW, 0);
        cabGrad.addColorStop(0, '#EA580C');
        cabGrad.addColorStop(0.5, '#F97316');
        cabGrad.addColorStop(1, '#C2410C');
        ctx.fillStyle = cabGrad;
        ctx.beginPath();
        ctx.roundRect(pillarX, pillarY, pillarW, pillarH, 4);
        ctx.fill();
        ctx.strokeStyle = '#7C2D12'; ctx.lineWidth = 1.5; ctx.stroke();

        // Cabinet Access Door
        ctx.fillStyle = '#1E293B';
        ctx.fillRect(pillarX + 3, pillarY + 22, pillarW - 6, 26);
        ctx.fillStyle = '#F59E0B';
        ctx.beginPath(); ctx.arc(pillarX + pillarW / 2, pillarY + 35, 2.5, 0, Math.PI * 2); ctx.fill();

        // Top Warning Strobe Beacon
        const beaconActive = targetAngle < -40;
        const strobeBlink = Math.floor(frameCount / 6) % 2 === 0;
        const beaconColor = beaconActive ? '#10B981' : (Math.abs(armAngle - targetAngle) > 4 && strobeBlink ? '#F59E0B' : '#EF4444');
        ctx.fillStyle = beaconColor;
        ctx.beginPath();
        ctx.arc(pillarX + pillarW / 2, pillarY - 3, 7.5, Math.PI, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#FFFFFF'; ctx.lineWidth = 1; ctx.stroke();

        // Smooth Mechanical Arm Rotation
        armAngle += (targetAngle - armAngle) * 0.075;

        // Draw Articulated Boom Arm
        ctx.save();
        ctx.translate(pillarX + 10, pillarY + 28);
        ctx.rotate((armAngle * Math.PI) / 180);

        const boomLength = 200;
        const boomHeight = 12;

        // White Aluminum Arm Profile
        ctx.fillStyle = '#F8FAFC';
        ctx.fillRect(-boomLength, -boomHeight / 2, boomLength, boomHeight);
        ctx.strokeStyle = '#94A3B8'; ctx.lineWidth = 1; ctx.strokeRect(-boomLength, -boomHeight / 2, boomLength, boomHeight);

        // 45° Red Retro-Reflective Hazard Chevron Stripes
        ctx.fillStyle = '#EF4444';
        for (let s = 12; s < boomLength - 12; s += 24) {
          ctx.beginPath();
          ctx.moveTo(-s, -boomHeight / 2);
          ctx.lineTo(-s - 12, boomHeight / 2);
          ctx.lineTo(-s - 22, boomHeight / 2);
          ctx.lineTo(-s - 10, -boomHeight / 2);
          ctx.closePath();
          ctx.fill();
        }

        // Active LED Neon Strip
        const neonCol = beaconActive ? '#10B981' : (Math.abs(armAngle - targetAngle) > 4 ? '#F59E0B' : '#EF4444');
        ctx.strokeStyle = neonCol;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(-boomLength + 6, -boomHeight / 2 - 1);
        ctx.lineTo(-4, -boomHeight / 2 - 1);
        ctx.stroke();

        // Lower Rubber Cushion
        ctx.fillStyle = '#0F172A';
        ctx.fillRect(-boomLength + 2, boomHeight / 2 - 1, boomLength - 4, 3);

        // Hub Collar & Flange Bolts
        ctx.fillStyle = '#334155';
        ctx.beginPath(); ctx.arc(0, 0, 9, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#E2E8F0';
        ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2); ctx.fill();

        ctx.restore();

        // Apply CCTV Effects & Security OSD
        const now = new Date().toLocaleTimeString(currentLang === 'ar' ? 'ar-DZ' : (currentLang === 'en' ? 'en-US' : 'fr-DZ'));
        const camTitle = (I18N[currentLang] && I18N[currentLang].cam3_name) || 'CAM-03 : SORTIE VOIE 2';
        drawCCTVEffects(ctx, cvs.width, cvs.height, 'CAM-03', camTitle, 25.0, now, true);

        requestAnimationFrame(render);
      }
      render();

      return {
        openBarrier: () => {
          targetAngle = -85;
          carRolling = true;
          carX = -100;
          const armEl = document.getElementById('cam3-arm-text');
          if (armEl) {
            armEl.innerText = currentLang === 'ar' ? 'مفتوح' : (currentLang === 'en' ? 'OPEN' : 'LEVEE (OUVERT)');
            armEl.className = 'text-emeraldAccent font-semibold';
          }
        }
      };
    }

