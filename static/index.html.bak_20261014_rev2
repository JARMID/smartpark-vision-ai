        ctx.moveTo(238, 45); ctx.lineTo(232, cvs.height - 20);
        ctx.moveTo(242, 45); ctx.lineTo(248, cvs.height - 20);
        ctx.stroke();

        // 2. Concrete Safety Curb (Beveled Yellow & Black Blocks on Left)
        for (let i = 0; i < 9; i++) {
          const t1 = i / 9, t2 = (i + 1) / 9;
          const y1 = 45 + t1 * (cvs.height - 65);
          const y2 = 45 + t2 * (cvs.height - 65);
