        } else {
          floorGrad.addColorStop(0, '#091122');
          floorGrad.addColorStop(0.5, '#060B18');
          floorGrad.addColorStop(1, '#030610');
        }
        ctx.fillStyle = floorGrad;
        ctx.fillRect(0, 0, cvs.width, cvs.height);

        // Epoxy Floor Joint Seams
        ctx.strokeStyle = isLight ? 'rgba(148, 163, 184, 0.5)' : 'rgba(30, 41, 59, 0.4)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let y = 30; y < cvs.height; y += 45) {
          ctx.moveTo(0, y); ctx.lineTo(cvs.width, y);
        }
        ctx.stroke();

        // 2. Central Driving Aisle
        ctx.fillStyle = isLight ? '#334155' : '#020617';
        ctx.fillRect(10, 115, cvs.width - 20, 42);
        ctx.strokeStyle = isLight ? '#64748B' : 'rgba(51, 65, 85, 0.6)';
        ctx.lineWidth = 1;
        ctx.strokeRect(10, 115, cvs.width - 20, 42);

        // Direction Arrows
        ctx.fillStyle = 'rgba(241, 245, 249, 0.7)';
        [100, 240, 380].forEach((ax, idx) => {
          ctx.beginPath();
          if (idx % 2 === 0) {
            ctx.moveTo(ax - 10, 133); ctx.lineTo(ax + 6, 133);
            ctx.lineTo(ax + 6, 130); ctx.lineTo(ax + 14, 136);
            ctx.lineTo(ax + 6, 142); ctx.lineTo(ax + 6, 139);
            ctx.lineTo(ax - 10, 139);
          } else {
            ctx.moveTo(ax + 10, 133); ctx.lineTo(ax - 6, 133);
            ctx.lineTo(ax - 6, 130); ctx.lineTo(ax - 14, 136);
            ctx.lineTo(ax - 6, 142); ctx.lineTo(ax - 6, 139);
            ctx.lineTo(ax + 10, 139);
          }
          ctx.closePath();
          ctx.fill();
        });

        // Green Pedestrian Safety Corridor (Right Side)
        ctx.fillStyle = isLight ? 'rgba(16, 185, 129, 0.25)' : 'rgba(6, 78, 59, 0.35)';
        ctx.fillRect(445, 20, 25, 230);
        ctx.strokeStyle = '#059669'; ctx.lineWidth = 1;
        ctx.strokeRect(445, 20, 25, 230);
        ctx.fillStyle = '#10B981';
        ctx.font = '7px JetBrains Mono';
        const pedText = currentLang === 'ar' ? 'مشاة' : (currentLang === 'en' ? 'WALK' : 'PIETONS');
        ctx.fillText(pedText, 446, 138);

        // 3. Render Parking Stalls (Rows A and B)
        const rowAY = 26;
        const rowBY = 162;
        const stallW = 52;
        const stallH = 82;
        const startX = 22;

        for (let i = 0; i < 7; i++) {
          const sx = startX + i * 59;
          renderSingleStall(ctx, sx, rowAY, stallW, stallH, `A0${i+1}`, i, true, isLight);
          renderSingleStall(ctx, sx, rowBY, stallW, stallH, `B0${i+1}`, i + 7, false, isLight);
        }

        // Apply CCTV Effects & Security OSD
        const now = new Date().toLocaleTimeString(currentLang === 'ar' ? 'ar-DZ' : (currentLang === 'en' ? 'en-US' : 'fr-DZ'));
        const camTitle = (I18N[currentLang] && I18N[currentLang].cam4_name) || 'CAM-04 : ZONE A & B (AERIENNE)';
        drawCCTVEffects(ctx, cvs.width, cvs.height, 'CAM-04', camTitle, 25.0, now, true);

        requestAnimationFrame(render);
      }

      function renderSingleStall(ctx, x, y, w, h, slotId, index, isTopRow, isLight) {
        const stallData = currentStalls.find(s => s.slot_number === slotId) || { status: 'vacant', plate: null };
        const isOcc = stallData.status === 'occupied';
        const isRes = stallData.status === 'reserved';

        // Dual Stall Marking Lines
        ctx.strokeStyle = isLight ? 'rgba(71, 85, 105, 0.6)' : 'rgba(241, 245, 249, 0.65)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x, y, w, h);

        // Yellow Concrete Wheel Stop Curb
        const curbY = isTopRow ? y + 4 : y + h - 8;
        ctx.fillStyle = '#F59E0B';
        ctx.fillRect(x + 5, curbY, w - 10, 4);
        ctx.strokeStyle = '#0F172A'; ctx.lineWidth = 0.8;
        ctx.strokeRect(x + 5, curbY, w - 10, 4);

        // Overhead Ultrasonic Sensor LED Lamp
        const ledX = x + w / 2;
        const ledY = isTopRow ? y + h - 5 : y + 5;
        const ledCol = isOcc ? '#EF4444' : (isRes ? '#A855F7' : '#10B981');
        ctx.fillStyle = ledCol;
        ctx.beginPath(); ctx.arc(ledX, ledY, 3.5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = isOcc ? 'rgba(239, 68, 68, 0.35)' : 'rgba(16, 185, 129, 0.35)';
        ctx.beginPath(); ctx.arc(ledX, ledY, 7, 0, Math.PI * 2); ctx.fill();

        // Slot Number Identifier
        ctx.fillStyle = isLight ? '#334155' : '#94A3B8';
        ctx.font = 'bold 7.5px JetBrains Mono';
        ctx.fillText(slotId, x + 4, isTopRow ? y + 14 : y + h - 10);

        if (isOcc) {
          const colScheme = vehicleColors[index % vehicleColors.length];
          const carW = w - 14;
          const carH = h - 20;
          const carX = x + 7;
          const carY = y + 10;

          // Vehicle Ground Shadow
          ctx.fillStyle = isLight ? 'rgba(15, 23, 42, 0.35)' : 'rgba(0, 0, 0, 0.65)';
          ctx.beginPath();
          ctx.roundRect(carX - 2, carY - 2, carW + 4, carH + 4, 8);
          ctx.fill();

          // Vehicle Body
          const vGrad = ctx.createLinearGradient(carX, carY, carX + carW, carY);
          vGrad.addColorStop(0, colScheme.body);
          vGrad.addColorStop(0.5, '#475569');
          vGrad.addColorStop(1, colScheme.body);
          ctx.fillStyle = vGrad;
          ctx.beginPath();
          ctx.roundRect(carX, carY, carW, carH, 6);
          ctx.fill();
          ctx.strokeStyle = isLight ? '#64748B' : '#1E293B'; ctx.lineWidth = 1; ctx.stroke();

          // Side Mirrors
          ctx.fillStyle = colScheme.body;
          ctx.fillRect(carX - 3, carY + (isTopRow ? 18 : carH - 24), 3, 7);
          ctx.fillRect(carX + carW, carY + (isTopRow ? 18 : carH - 24), 3, 7);

          // Front Windshield
          ctx.fillStyle = colScheme.glass;
          const wY = isTopRow ? carY + 16 : carY + carH - 24;
          ctx.beginPath();
          ctx.roundRect(carX + 3, wY, carW - 6, 9, 3);
          ctx.fill();

          // Sunroof
          ctx.fillStyle = colScheme.roof;
          ctx.beginPath();
          ctx.roundRect(carX + 4, carY + 28, carW - 8, carH - 46, 3);
          ctx.fill();

          // Rear Window
          ctx.fillStyle = colScheme.glass;
          const rY = isTopRow ? carY + carH - 16 : carY + 8;
          ctx.beginPath();
          ctx.roundRect(carX + 3, rY, carW - 6, 7, 2);
          ctx.fill();

          // Algerian License Plate on Bumper
          const pY = isTopRow ? carY + carH - 3 : carY + 1;
          ctx.fillStyle = '#FDE047';
          ctx.fillRect(carX + carW / 2 - 10, pY, 20, 4);
          ctx.strokeStyle = '#000000'; ctx.lineWidth = 0.5;
          ctx.strokeRect(carX + carW / 2 - 10, pY, 20, 4);

          // CV Bounding Box Overlay
          ctx.strokeStyle = '#EF4444';
          ctx.lineWidth = 1;
          ctx.strokeRect(carX - 1, carY - 1, carW + 2, carH + 2);
        } else {
          // Vacant Slot CV Detection Box
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)';
          ctx.lineWidth = 0.8;
          ctx.setLineDash([3, 3]);
          ctx.strokeRect(x + 4, y + 8, w - 8, h - 16);
          ctx.setLineDash([]);
          ctx.fillStyle = '#10B981';
          ctx.font = '7px JetBrains Mono';
          const freeText = (I18N[currentLang] && I18N[currentLang].stall_available) || 'LIBRE';
          ctx.fillText(freeText, x + w / 2 - 11, y + h / 2);
        }
      }

      render();
    }

